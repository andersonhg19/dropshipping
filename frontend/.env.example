# =============================================================================
#  VISNEX - Plantilla de variables de entorno del frontend
# -----------------------------------------------------------------------------
#  Copia este archivo a `frontend/.env` y rellena los valores.
#      cp frontend/.env.example frontend/.env
#
#  OJO: todo lo que empiece por NEXT_PUBLIC_ viaja al navegador y es visible
#  para cualquiera. No pongas aqui nada que deba ser secreto de verdad.
# =============================================================================

# API Backend (a traves del gateway)
NEXT_PUBLIC_API_URL=http://localhost:8841
NEXT_PUBLIC_TZ=America/Bogota
NEXT_PUBLIC_ID_COMPANY=1

# Cifrado del cache de sesion en el navegador. Generar con: openssl rand -hex 32
NEXT_PUBLIC_CACHE_SECRET=<openssl rand -hex 32>

# User defaults
NEXT_PUBLIC_ID_TYPE_USER=1
NEXT_PUBLIC_DECIMAL_NUMBER=0

# App version
REACT_APP_VERSION=V0.1.0
