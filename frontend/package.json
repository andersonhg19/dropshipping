{
  "name": "visnex-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env FORCE_COLOR=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx . --fix",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "analyze": "cross-env ANALYZE=true yarn build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\" && eslint . --fix",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\" && eslint .",
    "coupling-graph": "npx madge --extensions js,jsx,ts,tsx,css,md,mdx ./ --exclude '.next|tailwind.config.js|reset.d.ts|prettier.config.js|postcss.config.js|playwright.config.ts|next.config.js|next-env.d.ts|instrumentation.ts|e2e/|README.md|.eslintrc.js' --image graph.svg"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/material-nextjs": "^6.4.2",
    "@mui/system": "^7.0.0",
    "@mui/x-data-grid": "^7.29.7",
    "@next/bundle-analyzer": "^14.2.13",
    "@t3-oss/env-nextjs": "^0.7.1",
    "@toolpad/core": "^0.16.0",
    "crypto-js": "^4.2.0",
    "framer-motion": "^11.11.8",
    "i18next": "^23.15.1",
    "jotai": "^2.10.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.452.0",
    "next": "^15.5.6",
    "next-compose-plugins": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.5.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15",
    "eslint-plugin-react": "7.33.2",
    "postcss": "^8.4.31",
    "prettier": "^3.5.2",
    "tailwindcss": "^3.4.12",
    "typescript": "5.3.2"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "yarn@1.22.19"
}
