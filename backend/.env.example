# =============================================================================
#  VISNEX - Plantilla de variables de entorno del backend
# -----------------------------------------------------------------------------
#  Copia este archivo a `backend/.env` y rellena los valores.
#      cp backend/.env.example backend/.env
#
#  `backend/.env` esta en .gitignore y NUNCA debe commitearse.
#
#  Generar secretos fuertes:
#      SECRET (JWT):  openssl rand -base64 48
#      Contrasenas:   openssl rand -base64 24
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=visnex
POSTGRES_PASSWORD=<genera-uno>
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432
SPRING_DATASOURCE_USERNAME=visnex
SPRING_DATASOURCE_PASSWORD=<genera-uno>

# --- JWT ---
# OBLIGATORIO. Minimo 256 bits. Sin valor por defecto: si falta, los servicios
# no arrancan (a proposito).
SECRET=<openssl rand -base64 48>
# 24 horas en milisegundos. No subirlo sin implementar refresh token.
EXP_TIME=86400000

# --- MySQL / WordPress ---
WORDPRESS_DB_NAME=wordpress_vn
WORDPRESS_DB_USER=visnexwp
WORDPRESS_DB_PASSWORD=<genera-uno>
MYSQL_ROOT_PASSWORD=<genera-uno>

# --- Notification Service (SMTP) ---
NOTIFICATIONS_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

FRONTEND_RESET_BASE_URL=http://localhost:3001/users/reset-password

# --- WooCommerce API ---
# Generar en: WP Admin > WooCommerce > Ajustes > Avanzado > REST API
WC_URL=http://wordpress:80
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- CORS ---
# Lista EXPLICITA de origenes, separados por coma. Nunca "*" junto a
# allowCredentials: eso permite que cualquier web haga peticiones autenticadas.
# La IP de la maquina en la red de casa. Se repite abajo en CORS y en la URL
# de la API porque son variables que leen cosas distintas (Spring y Next), pero
# es el unico sitio donde hay que cambiarla si la red cambia.
VN_IP=192.168.40.32

# La IP va JUNTO a localhost, no en su lugar: el panel se abre desde el propio
# equipo y tambien desde el movil, y el navegador manda como Origin exactamente
# el host por el que se entro. Si aqui solo estuviera uno de los dos, desde el
# otro las llamadas a la API las corta el navegador con un error de CORS —que
# ademas se lee como "no responde", no como "falta permiso".
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8850,http://192.168.40.32:3001,http://192.168.40.32:8850

# --- WordPress ---
# 1 solo para depurar. En cualquier otro caso 0: con 1 los avisos de PHP se
# imprimen dentro de la tienda.
WORDPRESS_DEBUG=0

# --- Frontend (docker-compose lee TODO desde este archivo con --env-file) ---
NEXT_PUBLIC_API_URL=http://192.168.40.32:8841
NEXT_PUBLIC_TZ=America/Bogota
NEXT_PUBLIC_ID_COMPANY=1
NEXT_PUBLIC_CACHE_SECRET=<openssl rand -hex 32>
