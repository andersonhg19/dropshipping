# ==================== Docker / WordPress ====================
# WordPress core, plugins de terceros y uploads NO se versionan: se instalan.
# Lo que SI es nuestro (tema hijo, mu-plugins, plugins propios) se versiona.
wordpress/db-data/
wordpress/wp-content/*
!wordpress/wp-content/mu-plugins/
!wordpress/wp-content/themes/
wordpress/wp-content/themes/*
!wordpress/wp-content/themes/visnex/
!wordpress/wp-content/plugins/
wordpress/wp-content/plugins/*
!wordpress/wp-content/plugins/visnex-colombia/
!wordpress/config/

# ==================== IDE ====================
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ==================== OS ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== Environment ====================
# NUNCA commitear secretos. Las plantillas publicas son los .env.example
.env
.env.local
.env.*.local
!.env.example
*.log

# ==================== Build ====================
dist/
build/
*.tgz

# ==================== Scratch / temporales ====================
planif_user.txt
planif_asst.txt

# Claude Code local
.claude/settings.local.json
wordpress/config/wp-cli.phar

# Artefactos de trabajo de marca
brand/dmika/*.png
brand/dmika/__pycache__/

# Respaldos de la base antes de una migracion: utiles en local, no en el repo.
seguimiento/respaldo-*.sql.gz

# Punto de retoma: la base y las fotos se guardan en disco, no en git.
# 88 MB de fotos en el historial es algo que despues no se puede deshacer.
seguimiento/punto-de-retoma/*.gz
__pycache__/
*.pyc

# El lienzo montado son 3 MB con las fotos dentro: se regenera desde
# brand/canvas2/generar.py + canvas.json cuando haga falta.
brand/canvas2/dmika-*.html
brand/canvas2/_ver-*.html
brand/canvas2/_shot-*.png
brand/canvas2/_s-*.png
